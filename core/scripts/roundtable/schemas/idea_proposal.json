{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idea_proposal",
  "description": "Предложение стадии «идея»: слепой проход критика и авторская карточка (фаза 0).",
  "type": "object",
  "additionalProperties": false,
  "required": ["variant", "premises", "mechanism", "criteria_fit", "cost", "reversibility", "risks"],
  "properties": {
    "variant": {"type": "string", "minLength": 1},
    "premises": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "mechanism": {"type": "string", "minLength": 1},
    "criteria_fit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "fit"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "fit": {"type": "string", "minLength": 1}
        }
      }
    },
    "cost": {"type": "string", "minLength": 1},
    "reversibility": {"type": "string", "minLength": 1},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "возражения_к_постановке": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
