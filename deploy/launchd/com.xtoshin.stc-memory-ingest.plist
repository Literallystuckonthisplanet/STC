<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xtoshin.stc-memory-ingest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/xtoshin/Work/STC/core/scripts/memory_ingest.py</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/xtoshin/Work/STC/stc.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STC_MEMORY_ROOT</key>
    <string>/Users/xtoshin/Work/memory</string>
    <key>STC_TRANSCRIPTS_ROOT</key>
    <string>/Users/xtoshin/Work/transcripts</string>
    <key>PATH</key>
    <string>/Users/xtoshin/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- RunAtLoad covers boot/wake after the machine missed the calendar time;
       memory_ingest.py deduplicates the day before doing work. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/xtoshin/Work/memory/offline-ingest/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/xtoshin/Work/memory/offline-ingest/launchd.stderr.log</string>
</dict>
</plist>
